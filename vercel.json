{
  "regions": ["sfo1"],
  "functions": {
    "app/api/queues/workflows-retomada/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "workflows-retomada-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/campanhas-email/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "campanhas-email-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/respostas-email/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "respostas-email-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queues/comercial-acompanhamento/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "comercial-acompanhamento-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/engine/follow-up",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/workflows/processar",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/renovacao/processar",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/engine/follow-up?modo=healthcheck",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/engine/respostas-email-watchdog",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/engine/relatorio-semanal",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/comercial/handoff/acompanhamento",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/campanhas/watchdog-fila",
      "schedule": "*/10 * * * *"
    }
  ]
}
